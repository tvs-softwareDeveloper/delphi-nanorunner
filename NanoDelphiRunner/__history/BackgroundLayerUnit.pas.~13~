unit BackgroundLayerUnit;

interface

uses
  System.Classes, System.SysUtils, System.Types,
  FMX.Types, FMX.Controls, FMX.Objects, FMX.Graphics;

type
  TBackgroundLayer = class
  private
    d_images: array[0..1] of TImage;
    d_speedFactor: Single;
    d_width: Single;
    d_height: Single;
    d_offsetX: Single;
    procedure ApplyLayout;
  public
    constructor Create(AParent: TFmxObject; const ABitmap: TBitmap; ASpeed: Single);
    procedure Update(const ADeltaTime: Single; PlayerVelocity: Single);
    procedure Resize(const AWidth, AHeight: Single);
    procedure ResetPosition;
    procedure SendToBack;
    procedure BringToFront;
  end;

implementation

constructor TBackgroundLayer.Create(AParent: TFmxObject; const ABitmap: TBitmap; ASpeed: Single);
var
  i: Integer;
begin
  d_speedFactor := ASpeed;
  d_offsetX := 0;

  for i := 0 to 1 do
  begin
    d_images[i] := TImage.Create(AParent);
    d_images[i].Parent := AParent;
    d_images[i].Bitmap.Assign(ABitmap);
    d_images[i].WrapMode := TImageWrapMode.Stretch;
    d_images[i].HitTest := False;
    d_images[i].Stored := False;
    d_images[i].Position.Y := 0;
  end;
end;

procedure TBackgroundLayer.Resize(const AWidth, AHeight: Single);
begin
  d_width := AWidth;
  d_height := AHeight;
  ApplyLayout;
end;

procedure TBackgroundLayer.ResetPosition;
begin
  d_offsetX := 0;
  ApplyLayout;
end;

procedure TBackgroundLayer.ApplyLayout;
begin
  if d_width <= 0 then
    Exit;

  d_images[0].Width := d_width;
  d_images[0].Height := d_height;
  d_images[0].Position.X := d_offsetX;
  d_images[0].Position.Y := 0;

  d_images[1].Width := d_width;
  d_images[1].Height := d_height;
  d_images[1].Position.X := d_offsetX + d_width;
  d_images[1].Position.Y := 0;
end;

procedure TBackgroundLayer.Update(const ADeltaTime: Single; PlayerVelocity: Single);
var
  move: Single;
begin
  if d_width <= 0 then
    Exit;

  move := PlayerVelocity * d_speedFactor * ADeltaTime;
  d_offsetX := d_offsetX - move;

  while d_offsetX <= -d_width do
    d_offsetX := d_offsetX + d_width;

  while d_offsetX >= 0 do
    d_offsetX := d_offsetX - d_width;

  ApplyLayout;
end;

procedure TBackgroundLayer.SendToBack;
begin
  d_images[0].SendToBack;
  d_images[1].SendToBack;
end;

procedure TBackgroundLayer.BringToFront;
begin
  d_images[0].BringToFront;
  d_images[1].BringToFront;
end;

end.
