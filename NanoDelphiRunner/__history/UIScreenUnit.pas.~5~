  rectBackground.Stroke.Kind := TBrushKind.None;
  rectBackground.HitTest := False;

  d_card := TRectangle.Create(TbiParent);
  d_card.Parent := TbiParent;
  d_card.Align := TAlignLayout.Center;
  d_card.Width := 520;
  d_card.Height := 560;
  d_card.XRadius := 28;
  d_card.YRadius := 28;
  d_card.Fill.Color := $EE1F5E32;
  d_card.Stroke.Color := $FFFFD166;
  d_card.Stroke.Thickness := 3;
  d_card.HitTest := False;

  TitleLabel := TLabel.Create(d_card);
  TitleLabel.Parent := d_card;
  TitleLabel.Text := 'Nano Banana Runner';
  TitleLabel.Position.X := 60;
  TitleLabel.Position.Y := 58;
  TitleLabel.Width := 430;
  TitleLabel.Height := 42;
  TitleLabel.StyledSettings := [];
  TitleLabel.TextSettings.Font.Size := 30;
  TitleLabel.TextSettings.Font.Style := [TFontStyle.fsBold];
  TitleLabel.TextSettings.FontColor := $FFFFD166;

  SubTitleLabel := TLabel.Create(d_card);
  SubTitleLabel.Parent := d_card;
  SubTitleLabel.Text := 'Kies je stijl, vul je naam in en start je avontuur';
  SubTitleLabel.Position.X := 62;
  SubTitleLabel.Position.Y := 102;
  SubTitleLabel.Width := 430;
  SubTitleLabel.Height := 28;
  SubTitleLabel.StyledSettings := [];
  SubTitleLabel.TextSettings.Font.Size := 15;
  SubTitleLabel.TextSettings.FontColor := $FFE9F5DB;

  d_lblPlayerName := TLabel.Create(d_card);
  d_lblPlayerName.Parent := d_card;
  d_lblPlayerName.Text := 'Spelernaam';
  d_lblPlayerName.Position.X := 62;
  d_lblPlayerName.Position.Y := 152;
  d_lblPlayerName.Width := 180;
  d_lblPlayerName.Height := 24;
  d_lblPlayerName.StyledSettings := [];
  d_lblPlayerName.TextSettings.Font.Size := 15;
  d_lblPlayerName.TextSettings.Font.Style := [TFontStyle.fsBold];
  d_lblPlayerName.TextSettings.FontColor := $FFFFF3B0;

  d_edtPlayerName := TEdit.Create(d_card);
  d_edtPlayerName.Parent := d_card;
  d_edtPlayerName.Position.X := 62;
  d_edtPlayerName.Position.Y := 180;
  d_edtPlayerName.Width := 300;
  d_edtPlayerName.Height := 42;
  d_edtPlayerName.TextPrompt := 'Vul je naam in';

  d_chkMultiplayer := TCheckBox.Create(d_card);
  d_chkMultiplayer.Parent := d_card;
  d_chkMultiplayer.Text := 'multiplayer';
  d_chkMultiplayer.Position.X := 62;
  d_chkMultiplayer.Position.Y := 238;
  d_chkMultiplayer.Width := 180;
  d_chkMultiplayer.Height := 34;
  d_chkMultiplayer.StyledSettings := [];
  d_chkMultiplayer.TextSettings.Font.Size := 16;
  d_chkMultiplayer.TextSettings.FontColor := $FFFFFFFF;

  d_btnThemeJapanese := TButton.Create(d_card);
  d_btnThemeJapanese.Parent := d_card;
  d_btnThemeJapanese.Text := 'mythic japanese';
  d_btnThemeJapanese.Position.X := 62;
  d_btnThemeJapanese.Position.Y := 296;
  d_btnThemeJapanese.Width := 190;
  d_btnThemeJapanese.Height := 44;
  d_btnThemeJapanese.StyledSettings := [];
  d_btnThemeJapanese.TextSettings.Font.Style := [TFontStyle.fsBold];
  d_btnThemeJapanese.TextSettings.FontColor := $FF0B2B18;

  d_btnThemeMoonlanding := TButton.Create(d_card);
  d_btnThemeMoonlanding.Parent := d_card;
  d_btnThemeMoonlanding.Text := 'fake moonlanding';
  d_btnThemeMoonlanding.Position.X := 270;
  d_btnThemeMoonlanding.Position.Y := 296;
  d_btnThemeMoonlanding.Width := 190;
  d_btnThemeMoonlanding.Height := 44;
  d_btnThemeMoonlanding.StyledSettings := [];
  d_btnThemeMoonlanding.TextSettings.Font.Style := [TFontStyle.fsBold];
  d_btnThemeMoonlanding.TextSettings.FontColor := $FF0B2B18;

  d_lblSessions := TLabel.Create(d_card);
  d_lblSessions.Parent := d_card;
  d_lblSessions.Text := 'Open game sessies';
  d_lblSessions.Position.X := 62;
  d_lblSessions.Position.Y := 372;
  d_lblSessions.Width := 250;
  d_lblSessions.Height := 28;
  d_lblSessions.StyledSettings := [];
  d_lblSessions.TextSettings.Font.Size := 17;
  d_lblSessions.TextSettings.Font.Style := [TFontStyle.fsBold];
  d_lblSessions.TextSettings.FontColor := $FFFFD166;

  d_lstSession := TListBox.Create(d_card);
  d_lstSession.Parent := d_card;
  d_lstSession.Position.X := 62;
  d_lstSession.Position.Y := 408;
  d_lstSession.Width := 398;
  d_lstSession.Height := 146;
end;

//home resize
procedure THomeScreen.Resize;
var
  Padding: Single;
  ContentW: Single;
  ThemeGap: Single;
  ThemeButtonW: Single;
begin
  if not Assigned(d_card) then
    Exit;

  Padding := 32;
  ContentW := d_card.Width - Padding * 2;

  d_lblPlayerName.Position.X := Padding;
  d_lblPlayerName.Width := ContentW;

  d_edtPlayerName.Position.X := Padding;
  d_edtPlayerName.Width := ContentW;

  d_chkMultiplayer.Position.X := Padding;
  d_chkMultiplayer.Width := ContentW;

  ThemeGap := 16;

  if ContentW > 390 then
  begin
    ThemeButtonW := (ContentW - ThemeGap) / 2;

    d_btnThemeJapanese.Position.X := Padding;
    d_btnThemeJapanese.Width := ThemeButtonW;

    d_btnThemeMoonlanding.Position.X := Padding + ThemeButtonW + ThemeGap;
    d_btnThemeMoonlanding.Position.Y := 296;
    d_btnThemeMoonlanding.Width := ThemeButtonW;

    d_lblSessions.Position.Y := 372;
  end
  else
  begin
    d_btnThemeJapanese.Position.X := Padding;
    d_btnThemeJapanese.Width := ContentW;

    d_btnThemeMoonlanding.Position.X := Padding;
    d_btnThemeMoonlanding.Position.Y := 350;
    d_btnThemeMoonlanding.Width := ContentW;

    d_lblSessions.Position.Y := 426;
  end;

  d_lblSessions.Position.X := Padding;
  d_lblSessions.Width := ContentW;

  d_lstSession.Position.X := Padding;
  d_lstSession.Position.Y := d_lblSessions.Position.Y + 36;
  d_lstSession.Width := ContentW;
  d_lstSession.Height := d_card.Height - d_lstSession.Position.Y - Padding;
end;

constructor TLobbyScreen.Create(AParent: TTabItem);
begin
  inherited Create;
  d_parent := AParent;
end;

destructor TLobbyScreen.Destroy;
begin
