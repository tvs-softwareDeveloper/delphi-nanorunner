unit UIScreenUnit;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  System.IniFiles,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.Menus,
  FMX.Controls.Presentation, FMX.StdCtrls, FMX.TabControl,
  FMX.Objects, FMX.Layouts, InputStateUnit,
  FMX.Platform.Win, FMX.Edit, FMX.ListBox, System.Math, ErrorHandlerUnit;

type
  THomeScreen = class
  private
    TbiParent: TTabItem;

    rectBackground: TRectangle;
    d_card: TRectangle;

    d_lblPlayerName: TLabel;
    d_lblSessions: TLabel;

    d_edtPlayerName: TEdit;
    d_chkMultiplayer: TCheckBox;

    d_btnThemeJapanese: TButton;
    d_btnThemeMoonlanding: TButton;

    d_lstSession: TListBox;

  public
    constructor Create(AParent: TTabItem);
    destructor Destroy; override;

    procedure Build;
    procedure Resize;

    property Card: TRectangle read d_card;
    property PlayerNameLabel: TLabel read d_lblPlayerName;
    property SessionsLabel: TLabel read d_lblSessions;
    property PlayerNameEdit: TEdit read d_edtPlayerName;
    property MultiplayerCheckBox: TCheckBox read d_chkMultiplayer;
    property ThemeJapaneseButton: TButton read d_btnThemeJapanese;
    property ThemeMoonlandingButton: TButton read d_btnThemeMoonlanding;
    property SessionList: TListBox read d_lstSession;
  end;

  TLobbyScreen = class
  private
    d_parent: TTabItem;

    d_background: TRectangle;
    d_card: TRectangle;

    d_lblLobbyTitle: TLabel;
    d_lblLobbyPlayers: TLabel;
    d_lstLobbyPlayer: TListBox;
    d_btnBackToHome: TButton;

  public
    constructor Create(AParent: TTabItem);
    destructor Destroy; override;

    procedure Build;
    procedure Resize;

    property Card: TRectangle read d_card;
    property LobbyTitleLabel: TLabel read d_lblLobbyTitle;
    property LobbyPlayersLabel: TLabel read d_lblLobbyPlayers;
    property LobbyPlayerList: TListBox read d_lstLobbyPlayer;
    property BackToHomeButton: TButton read d_btnBackToHome;
  end;

implementation

constructor THomeScreen.Create(AParent: TTabItem);
begin
  inherited Create;
  TbiParent := AParent;
end;

destructor THomeScreen.Destroy;
begin
  inherited;
end;

//home build
