// this reads obstacle data that came from the host
// netid is used to find the same obstacle again next time
// x and y are the wanted place on the map
// w and h are the size of the obstacle
// seenids is used to remember which obstacles still exist on the host
procedure TGameEngine.ApplyObstacleSyncText(const AText: string);
var
  DataText: string;
  ObstacleParts: TArray<string>;
  Values: TArray<string>;
  I: Integer;
  J: Integer;
  O: TObstacle;
  Found: Boolean;
  NetId: Integer;
  KindValue: Integer;
  Kind: TObstacleKind;
  X: Single;
  Y: Single;
  W: Single;
  H: Single;
  FrameIndex: Integer;
  FS: TFormatSettings;
  SeenIds: TList<Integer>;
begin
  if not Assigned(d_obstacleManager) then
    Exit;

  SeenIds := nil;

  try
    // this makes sure decimal numbers use a dot
    // example 12.5 works the same on every pc
    FS := TFormatSettings.Invariant;
    DataText := AText;

    // the server sends messages with obstacles| in front
    // this removes that part so only the real data is left
    if Pos('obstacles|', DataText) = 1 then
      Delete(DataText, 1, Length('obstacles|'));

    // if the host sends no obstacle data, this client must also remove all obstacles
    if Trim(DataText) = '' then
    begin
      d_obstacleManager.ClearObstacles;
      Exit;
    end;

    SeenIds := TList<Integer>.Create;

    // this cuts the full text into small obstacle blocks
    ObstacleParts := DataText.Split([';']);

    for I := 0 to Length(ObstacleParts) - 1 do
    begin
      // this cuts one obstacle block into separate values
      Values := ObstacleParts[I].Split([',']);

      // the obstacle needs at least 7 values
      // if less values are received, this block is broken and skipped
      if Length(Values) < 7 then
        Continue;

      NetId := StrToIntDef(Values[0], 0);
      KindValue := StrToIntDef(Values[1], 0);

      // skip invalid network data
      if NetId <= 0 then
        Continue;

      // kindvalue is a number that must fit inside the obstacle kind list
      // low is the first allowed kind
      // high is the last allowed kind
      // if the number is outside that range, it could crash later, so it is skipped
      if (KindValue < Ord(Low(TObstacleKind))) or (KindValue > Ord(High(TObstacleKind))) then
        Continue;

      Kind := TObstacleKind(KindValue);

      // these values come from text, so they are changed back into numbers
      // strtofloatdef uses a safe default when the value is broken
      // max makes sure width and height can never become 0 or negative
      X := StrToFloatDef(Values[2], 0, FS);
      Y := StrToFloatDef(Values[3], 0, FS);
      W := Max(1, StrToFloatDef(Values[4], TGameConfig.OBSTACLE_NORMAL_WIDTH, FS));
      H := Max(1, StrToFloatDef(Values[5], TGameConfig.OBSTACLE_NORMAL_HEIGHT, FS));
      FrameIndex := Max(0, StrToIntDef(Values[6], 0));

      // this id was received from the host
      // later we remove every local obstacle that was not seen in this new list
      if SeenIds.IndexOf(NetId) = -1 then
        SeenIds.Add(NetId);

      O := nil;
      Found := False;

      // search if this obstacle already exists on this client
      // this is a simple loop through all local obstacles
      // when the same netid is found, we update that obstacle instead of making a new one
      for J := 0 to d_obstacleManager.GetObstacles.Count - 1 do
      begin
        if d_obstacleManager.GetObstacles[J].GetNetId = NetId then
        begin
          O := d_obstacleManager.GetObstacles[J];
          Found := True;
          Break;
        end;
      end;

      // if no obstacle with this netid exists yet, make it
      if not Found then
      begin
        O := d_obstacleManager.GetObstacleFromPool;
        O.SetNetId(NetId);

        // dragon uses a bigger default value
        // the other obstacle kinds use the normal default value
        case Kind of
          okDragon:
            O.Initialize(TPointF.Create(X, Y), TGameConfig.OBSTACLE_SPEED * TGameConfig.DRAGON_SPEED_MULTIPLIER);
        else
          O.Initialize(TPointF.Create(X, Y), TGameConfig.OBSTACLE_SPEED);
        end;

        d_obstacleManager.GetObstacles.Add(O);
      end;

      // update all values with the newest data from the host
      O.SetKind(Kind);
      O.SetSize(W, H);
      O.SetFrameIndex(FrameIndex);

      // this does not instantly teleport the obstacle
      // the obstacle can move smoothly toward this target in its own update code
      O.SetRemoteTarget(TPointF.Create(X, Y));

      // each obstacle type can have a different amount of animation frames
      // max makes sure the number is always at least 1
      // this prevents divide by zero or invalid frame logic in animation code
      case Kind of
        okPotato:
          O.SetTotalFrames(Max(1, d_assets.d_potatoFrames.Count));

        okDragon:
          O.SetTotalFrames(Max(1, d_assets.d_dragonFrames.Count));
      else
        O.SetTotalFrames(Max(1, d_assets.d_obstacleFrames.Count));
      end;
    end;

    // remove obstacles that are not in the latest host sync text
    // this loop goes backwards because deleting changes the list numbers
    // example: if item 2 is deleted, item 3 moves to place 2
    // going backwards prevents skipping an item
    for J := d_obstacleManager.GetObstacles.Count - 1 downto 0 do
    begin
      if not SeenIds.Contains(d_obstacleManager.GetObstacles[J].GetNetId) then
        d_obstacleManager.RemoveObstacle(d_obstacleManager.GetObstacles[J]);
    end;

  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('obstacle sync error: ' + E.Message);
    end;
  end;

  SeenIds.Free;
end;


procedure TGameEngine.ChangeDemonState(const ANewState: TDemonState);
begin
  try
    if d_demonState = ANewState then
      Exit;

    d_demonState := ANewState;

    case d_demonState of
      dsHidden:
        begin
          // hide demon and reset animation
          d_demonFrameIndex := 0;
          d_demonAnimTimer := 0;

          if Assigned(d_imgDemon) then
            d_imgDemon.Visible := False;
        end;

      dsMovingUp:
        begin
          // demon starts below the screen and moves up
          d_demonFrameIndex := 0;
          d_demonAnimTimer := 0;

          if Assigned(d_imgDemon) then
            d_imgDemon.Visible := True;
        end;

      dsShowing:
        begin
          // demon is in the middle and keeps playing animation
        end;

      dsMovingDown:
        begin
          // demon moves down until it leaves the screen
        end;
    end;
  except
    on E: Exception do
      TErrorHandler.ReportError('demon change state error: ' + E.Message);
  end;
end;

procedure TGameEngine.StartDemonEvent(const AParent: TControl);
begin
  try
    if not Assigned(AParent) then
      Exit;

    // place demon in the horizontal center
    d_demonX := (AParent.Width - d_demonW) / 2;

    // start below the screen
    d_demonY := AParent.Height;

    d_demonFrameIndex := 0;
    d_demonAnimTimer := 0;

    if Assigned(d_imgDemon) then
    begin
      d_imgDemon.Width := d_demonW;
      d_imgDemon.Height := d_demonH;
      d_imgDemon.Position.X := d_demonX;
      d_imgDemon.Position.Y := d_demonY;
      d_imgDemon.Visible := True;
    end;

    // set next meter moment for the next demon event
    d_nextDemonMeter := d_nextDemonMeter + TGameConfig.DEMON_INTERVAL_METER;

    ChangeDemonState(dsMovingUp);
  except
    on E: Exception do
      TErrorHandler.ReportError('start demon event error: ' + E.Message);
  end;
end;

procedure TGameEngine.UpdateDemon(const ADeltaTime: Single; const AParent: TControl);
var
  TargetY: Single;
begin
  try
    if ADeltaTime <= 0 then
      Exit;

    if not Assigned(AParent) then
      Exit;

    if d_demonState = dsHidden then
      Exit;

    // keep demon centered when the screen size changes
    d_demonX := (AParent.Width - d_demonW) / 2;

    // middle y position of the screen
    TargetY := (AParent.Height - d_demonH) / 2;

    // update animation timer
    d_demonAnimTimer := d_demonAnimTimer + ADeltaTime;

    if d_demonAnimTimer >= TGameConfig.DEMON_ANIM_SPEED then
    begin
      if d_demonFrameIndex < d_assets.DemonFrames.Count - 1 then
        Inc(d_demonFrameIndex);

      d_demonAnimTimer := 0;
    end;

    case d_demonState of
      dsMovingUp:
        begin
          // move demon up until it reaches the middle
          d_demonY := d_demonY - (TGameConfig.DEMON_MOVE_SPEED * ADeltaTime);

          if d_demonY <= TargetY then
          begin
            d_demonY := TargetY;
            ChangeDemonState(dsShowing);
          end;
        end;

      dsShowing:
        begin
          // wait until the animation reaches the frame where demon must leave
          if d_demonFrameIndex >= TGameConfig.DEMON_MOVE_DOWN_FRAME then
            ChangeDemonState(dsMovingDown);
        end;

      dsMovingDown:
        begin
          // move demon down until it is outside the screen
          d_demonY := d_demonY + (TGameConfig.DEMON_MOVE_SPEED * ADeltaTime);

          if d_demonY > AParent.Height then
            ChangeDemonState(dsHidden);
        end;
    end;

    if Assigned(d_imgDemon) then
    begin
      d_imgDemon.Position.X := d_demonX;
      d_imgDemon.Position.Y := d_demonY;
    end;
  except
    on E: Exception do
      TErrorHandler.ReportError('update demon error: ' + E.Message);
  end;
end;


