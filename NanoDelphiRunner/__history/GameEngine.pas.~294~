procedure TGameEngine.StartGameWithOptions(const AResetObstacles: Boolean);
var
  bg: TBackgroundLayer;
begin
  if not Assigned(d_player) or not Assigned(d_obstacleManager) then
    Exit;

  d_isRunning := True;
  d_gameOver := False;
  d_survivalTime := 0;
  d_distanceMeters := 0;
  d_worldScrollX := 0;

  d_player.SetPosition(TPointF.Create(d_player_x, d_player_y));
  d_player.SetGroundY(d_player_y);
  d_player.ChangeState(psIdle);

  ChangeDemonState(dsHidden);
  d_demonFrameIndex := 0;
  d_demonAnimTimer := 0;
  d_nextDemonMeter := TGameConfig.DEMON_FIRST_METER;

  d_cameraX := 0;
  d_worldPlayerX := d_player_x;
  d_lastFrontPlayerWorldX := d_worldPlayerX;

  if AResetObstacles then
    d_obstacleSpawnWorldX := d_worldPlayerX;

  if Assigned(d_imgDemon) then
    d_imgDemon.Visible := False;

  for bg in d_backgrounds do
    bg.ResetPosition;

  if AResetObstacles then
    d_obstacleManager.Reset;

end;

