function TGameEngine.GetPlayerSyncText(const APlayerName: string): string;
var
  P: TPointF;
  FS: TFormatSettings;
begin
  if not Assigned(d_player) then
    Exit('');

  FS := TFormatSettings.Invariant;
  P := d_player.GetPosition;

  Result := Format(
    'state|%s|%.2f|%.2f|%d|%d|%d|%.2f|%.0f',
    [
      APlayerName,
      d_worldPlayerX,
      P.Y,
      Ord(d_player.CurrentState),
      d_player.GetCurrentSpriteIndex,
      Ord(d_player.GetFacingRight),
      d_player.GetAirTime,
      d_distanceMeters
    ],
    FS
  );
end;

