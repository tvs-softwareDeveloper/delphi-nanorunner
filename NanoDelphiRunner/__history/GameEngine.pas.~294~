procedure TGameEngine.SetHostMode(const AValue: Boolean);
begin
  try
    // do nothing if the value did not change
    if d_isHostMode = AValue then
      Exit;

    d_isHostMode := AValue;

    // when this client becomes host, old remote obstacles must become normal moving obstacles
    if d_isHostMode and Assigned(d_obstacleManager) then
      d_obstacleManager.TakeOwnershipOfObstacles;
  except
    on E: Exception do
      TErrorHandler.ReportError('set host mode error: ' + E.Message);
  end;
end;

function TGameEngine.GetObstacleSyncText: string;
var
  I: Integer;
  O: TObstacle;
  P: TPointF;
  S: TSizeF;
  FS: TFormatSettings;
begin
  FS := TFormatSettings.Invariant;
  Result := 'obstacles|';

  if not Assigned(d_obstacleManager) then
    Exit;

  for I := 0 to d_obstacleManager.GetObstacles.Count - 1 do
  begin
    O := d_obstacleManager.GetObstacles[I];
    P := O.GetPosition;
    S := O.GetSize;

    if I > 0 then
      Result := Result + ';';

    Result := Result + Format(
      '%d,%d,%.2f,%.2f,%.2f,%.2f,%d',
      [
        O.GetNetId,
        Ord(O.GetKind),
        P.X,
        P.Y,
        S.Width,
        S.Height,
        O.GetFrameIndex
      ],
      FS
    );
  end;
end;

