unit RemotePlayerRendererUnit;

interface

uses
  System.Classes, System.SysUtils, System.Types, System.Generics.Collections, System.UITypes,
  FMX.Types, FMX.Forms, FMX.Controls, FMX.Objects, FMX.Graphics, FMX.StdCtrls,
  PlayerUnit, ObstacleManagerUnit, ObstacleUnit, System.Math, FMX.Utils,
  BackgroundLayerUnit, ErrorHandlerUnit, GameConfigUnit, AssetManagerUnit;

type
  TRemotePlayerRenderState = class
  public
    LastFrame: Integer;
    LastState: TPlayerState;

    constructor Create;
  end;

  TRemotePlayerRenderer = class
  private
    d_form: TForm;
    d_parent: TControl;
    d_localPlayerImage: TImage;
    d_assets: TAssetManager;

    d_remotePlayerImages: TObjectDictionary<string, TImage>;
    d_remotePlayerNameLabels: TObjectDictionary<string, TLabel>;
    d_remotePlayerRenderStates: TObjectDictionary<string, TRemotePlayerRenderState>;
    d_remotePlayerWorldX: TObjectDictionary<string, Single>;

    d_playerNormalW: Single;
    d_playerNormalH: Single;
    d_playerJetpackW: Single;
    d_playerJetpackH: Single;

    procedure SetImageBitmapIfChanged(AImage: TImage; ABitmap: TBitmap; var ALastFrame: Integer; ANewFrame: Integer);

  public
    constructor Create;
    destructor Destroy; override;

    procedure Initialize(const AForm: TForm; const AParent: TControl; const ALocalPlayerImage: TImage; const AAssets: TAssetManager);
    procedure UpdateRemotePlayer(const AName: string; const AX, AY: Single; const AState, AFrame: Integer; const AFacingRight: Boolean; const AAirTime: Single; const ACameraX: Single);
    procedure BringToFront;

    function GetLastPlayerWorldX(const ALocalWorldX: Single): Single;
    function GetFrontPlayerWorldX(const ALocalWorldX: Single): Single;
    function HasRemotePlayers: Boolean;
  end;

implementation

constructor TRemotePlayerRenderState.Create;
begin
  inherited;
  LastFrame := -1;
  LastState := psIdle;
end;

constructor TRemotePlayerRenderer.Create;
begin
  inherited;

  d_remotePlayerImages := TObjectDictionary<string, TImage>.Create([doOwnsValues]);
  d_remotePlayerNameLabels := TObjectDictionary<string, TLabel>.Create([doOwnsValues]);
  d_remotePlayerRenderStates := TObjectDictionary<string, TRemotePlayerRenderState>.Create([doOwnsValues]);
  d_remotePlayerWorldX := TObjectDictionary<string, Single>.Create;

  d_playerNormalW := TGameConfig.PLAYER_NORMAL_WIDTH;
  d_playerNormalH := TGameConfig.PLAYER_NORMAL_HEIGHT;
  d_playerJetpackW := TGameConfig.PLAYER_JETPACK_WIDTH;
  d_playerJetpackH := TGameConfig.PLAYER_JETPACK_HEIGHT;
end;

destructor TRemotePlayerRenderer.Destroy;
begin
  FreeAndNil(d_remotePlayerImages);
  FreeAndNil(d_remotePlayerNameLabels);
  FreeAndNil(d_remotePlayerRenderStates);
  FreeAndNil(d_remotePlayerWorldX);

  inherited;
end;

procedure TRemotePlayerRenderer.Initialize(const AForm: TForm; const AParent: TControl; const ALocalPlayerImage: TImage; const AAssets: TAssetManager);
begin
  d_form := AForm;
  d_parent := AParent;
  d_localPlayerImage := ALocalPlayerImage;
  d_assets := AAssets;
end;

procedure TRemotePlayerRenderer.SetImageBitmapIfChanged(AImage: TImage; ABitmap: TBitmap; var ALastFrame: Integer; ANewFrame: Integer);
begin
  if not Assigned(AImage) or not Assigned(ABitmap) then
    Exit;

  if ALastFrame = ANewFrame then
    Exit;

  AImage.Bitmap.Assign(ABitmap);
  ALastFrame := ANewFrame;
end;

procedure TRemotePlayerRenderer.UpdateRemotePlayer(const AName: string; const AX, AY: Single; const AState, AFrame: Integer; const AFacingRight: Boolean; const AAirTime: Single; const ACameraX: Single);
var
  RemoteImg: TImage;
  State: TPlayerState;
  FrameIndex: Integer;
  ScreenX: Single;
  ScreenW: Single;
  Angle: Single;
  RenderState: TRemotePlayerRenderState;
  NameLabel: TLabel;
begin
  try
    if Trim(AName) = '' then
      Exit;

    if not Assigned(d_form) or not Assigned(d_parent) or not Assigned(d_assets) then
      Exit;

    if (AState < Ord(Low(TPlayerState))) or (AState > Ord(High(TPlayerState))) then
    begin
      TErrorHandler.ReportError('remote player state is invalid: ' + AState.ToString);
      Exit;
    end;

    State := TPlayerState(AState);
    ScreenX := AX - ACameraX;

    d_remotePlayerWorldX.AddOrSetValue(AName, AX);

    ScreenW := d_parent.Width;

    if not d_remotePlayerImages.TryGetValue(AName, RemoteImg) then
    begin
      RemoteImg := TImage.Create(d_form);
      RemoteImg.Parent := d_parent;
      RemoteImg.Width := d_playerNormalW;
      RemoteImg.Height := d_playerNormalH;
      RemoteImg.WrapMode := TImageWrapMode.Fit;
      RemoteImg.HitTest := False;
      RemoteImg.Stored := False;
      RemoteImg.Opacity := TGameConfig.REMOTE_PLAYER_OPACITY;

      d_remotePlayerImages.Add(AName, RemoteImg);
    end;

    if not d_remotePlayerNameLabels.TryGetValue(AName, NameLabel) then
    begin
      NameLabel := TLabel.Create(d_form);
      NameLabel.Parent := d_parent;
      NameLabel.Text := AName;
      NameLabel.Width := 140;
      NameLabel.Height := 24;
      NameLabel.HitTest := False;
      NameLabel.Stored := False;
      NameLabel.TextSettings.HorzAlign := TTextAlign.Center;
      NameLabel.TextSettings.Font.Size := 14;
      NameLabel.TextSettings.Font.Style := [TFontStyle.fsBold];
      NameLabel.StyledSettings := [];

      d_remotePlayerNameLabels.Add(AName, NameLabel);
    end;

    if not d_remotePlayerRenderStates.TryGetValue(AName, RenderState) then
    begin
      RenderState := TRemotePlayerRenderState.Create;
      d_remotePlayerRenderStates.Add(AName, RenderState);
    end;

    if RenderState.LastState <> State then
    begin
      RenderState.LastState := State;
      RenderState.LastFrame := -1;
    end;

    if (ScreenX < -TGameConfig.REMOTE_PLAYER_HIDE_MARGIN) or (ScreenX > ScreenW + TGameConfig.REMOTE_PLAYER_HIDE_MARGIN) then
    begin
      RemoteImg.Visible := False;
      NameLabel.Visible := False;
      Exit;
    end;

    if State in [psJetpackUp, psJetpackFlying] then
    begin
      RemoteImg.Width := d_playerJetpackW;
      RemoteImg.Height := d_playerJetpackH;
    end
    else
    begin
      RemoteImg.Width := d_playerNormalW;
      RemoteImg.Height := d_playerNormalH;
    end;

    if State in [psJetpackUp, psJetpackFlying] then
      RemoteImg.Position.X := ScreenX - ((RemoteImg.Width - d_playerNormalW) / 2)
    else if AFacingRight then
      RemoteImg.Position.X := ScreenX - ((RemoteImg.Width - d_playerNormalW) / 2)
    else
      RemoteImg.Position.X := ScreenX + d_playerNormalW + ((RemoteImg.Width - d_playerNormalW) / 2);

    RemoteImg.Position.Y := AY - (RemoteImg.Height - d_playerNormalH);

    NameLabel.Position.X := RemoteImg.Position.X + (RemoteImg.Width / 2) - (NameLabel.Width / 2);
    NameLabel.Position.Y := RemoteImg.Position.Y - NameLabel.Height - 4;
    NameLabel.Visible := True;

    if AFacingRight or (State in [psJetpackUp, psJetpackFlying]) then
      RemoteImg.Scale.X := 1
    else
      RemoteImg.Scale.X := -1;

    RemoteImg.RotationAngle := 0;

    if State = psJetpackUp then
    begin
      if d_assets.d_jetpackUpFrames.Count > 0 then
      begin
        FrameIndex := EnsureRange(AFrame, 0, d_assets.d_jetpackUpFrames.Count - 1);
        SetImageBitmapIfChanged(RemoteImg, d_assets.d_jetpackUpFrames[FrameIndex], RenderState.LastFrame, FrameIndex);
      end;
    end
    else if State = psJetpackFlying then
    begin
      if d_assets.d_jetpackFlyFrames.Count > 0 then
      begin
        FrameIndex := EnsureRange(AFrame, 0, d_assets.d_jetpackFlyFrames.Count - 1);
        SetImageBitmapIfChanged(RemoteImg, d_assets.d_jetpackFlyFrames[FrameIndex], RenderState.LastFrame, FrameIndex);
      end;
    end
    else if State in [psJumpStart, psJumping, psFalling] then
    begin
      if not d_assets.d_jumpSprite.IsEmpty then
      begin
        RemoteImg.Bitmap.Assign(d_assets.d_jumpSprite);

        Angle := 360 * (AAirTime / TGameConfig.PLAYER_JUMP_ROTATION_TIME);
        RemoteImg.RotationAngle := Angle;
      end;
    end
    else
    begin
      if d_assets.d_playerFrames.Count > 0 then
      begin
        FrameIndex := EnsureRange(AFrame, 0, d_assets.d_playerFrames.Count - 1);
        SetImageBitmapIfChanged(RemoteImg, d_assets.d_playerFrames[FrameIndex], RenderState.LastFrame, FrameIndex);
      end;
    end;

    RemoteImg.Visible := True;
    RemoteImg.BringToFront;
    NameLabel.BringToFront;

    if Assigned(d_localPlayerImage) then
      d_localPlayerImage.BringToFront;
  except
    on E: Exception do
      TErrorHandler.ReportError('remote player update error: ' + E.Message);
  end;
end;

procedure TRemotePlayerRenderer.BringToFront;
var
  PairImg: TPair<string, TImage>;
  PairLabel: TPair<string, TLabel>;
begin
  for PairImg in d_remotePlayerImages do
    if Assigned(PairImg.Value) then
      PairImg.Value.BringToFront;

  for PairLabel in d_remotePlayerNameLabels do
    if Assigned(PairLabel.Value) then
      PairLabel.Value.BringToFront;

  if Assigned(d_localPlayerImage) then
    d_localPlayerImage.BringToFront;
end;

function TRemotePlayerRenderer.GetLastPlayerWorldX(const ALocalWorldX: Single): Single;
var
  Pair: TPair<string, Single>;
begin
  Result := ALocalWorldX;

  for Pair in d_remotePlayerWorldX do
    if Pair.Value < Result then
      Result := Pair.Value;
end;

function TRemotePlayerRenderer.GetFrontPlayerWorldX(const ALocalWorldX: Single): Single;
var
  Pair: TPair<string, Single>;
begin
  Result := ALocalWorldX;

  for Pair in d_remotePlayerWorldX do
    if Pair.Value > Result then
      Result := Pair.Value;
end;

function TRemotePlayerRenderer.HasRemotePlayers: Boolean;
begin
  Result := d_remotePlayerWorldX.Count > 0;
end;

end.
