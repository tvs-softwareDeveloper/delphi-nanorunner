procedure TGameEngine.SetImageBitmapIfChanged(AImage: TImage; ABitmap: TBitmap; var ALastFrame: Integer; ANewFrame: Integer);
begin
  if not Assigned(AImage) or not Assigned(ABitmap) then
    Exit;

  if ALastFrame = ANewFrame then
    Exit;

  AImage.Bitmap.Assign(ABitmap);
  ALastFrame := ANewFrame;
end;

function TGameEngine.GetFrontPlayerSpeed(const ADeltaTime: Single): Single;
var
  FrontX: Single;
begin
  Result := 0;

  try
    if ADeltaTime <= 0 then
      Exit;

    FrontX := GetFrontPlayerWorldX;

    // never use backwards movement for spawning
    if FrontX <= d_lastFrontPlayerWorldX then
      Exit;

    // calculate forward speed of the front player
    Result := (FrontX - d_lastFrontPlayerWorldX) / ADeltaTime;

    // stop one big jump from spawning many obstacles after restart
    Result := Min(Result, TGameConfig.MAX_FRONT_PLAYER_SPEED);

    // save the highest known front position
    d_lastFrontPlayerWorldX := FrontX;
  except
    on E: Exception do
      TErrorHandler.ReportError('get front player speed error: ' + E.Message);
  end;
end;

function TGameEngine.GetSafeSpawnBaseX(const AParentWidth: Single): Single;
var
  FrontX: Single;
  WantedSpawnX: Single;
begin
  Result := d_obstacleSpawnWorldX;

  try
    FrontX := GetFrontPlayerWorldX;

    // spawn must be in front of the front player
    WantedSpawnX := FrontX + AParentWidth + TGameConfig.SPAWN_RIGHT_MARGIN;

    // spawn line may only move to the right
    if WantedSpawnX > d_obstacleSpawnWorldX then
      d_obstacleSpawnWorldX := WantedSpawnX;

    Result := d_obstacleSpawnWorldX;
  except
    on E: Exception do
      TErrorHandler.ReportError('get safe spawn base x error: ' + E.Message);
  end;
end;

