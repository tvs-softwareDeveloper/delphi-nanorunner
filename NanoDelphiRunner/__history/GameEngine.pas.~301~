procedure TGameEngine.SetTheme(const ATheme: TGameTheme);
begin
  if not Assigned(d_assets) then
    Exit;

  d_assets.SetTheme(ATheme);

  if Assigned(d_form) then
  begin
    d_assets.LoadThemeAssets;

    d_obstacleManager.SetPotatoTotalFrames(Max(1, d_assets.PotatoFrames.Count));
    d_obstacleManager.SetDragonTotalFrames(Max(1, d_assets.DragonFrames.Count));
    d_obstacleManager.SetTotalFrames(Max(1, d_assets.ObstacleFrames.Count));

    RebuildBackgrounds;
    ApplyLayerOrder;

    if Assigned(d_imgPlayer) and Assigned(d_imgPlayer.Parent) then
      SetCanvasSize((d_imgPlayer.Parent as TControl).Width, (d_imgPlayer.Parent as TControl).Height);
  end;
end;

procedure TGameEngine.StartGameWithOptions(const AResetObstacles: Boolean);
var
  bg: TBackgroundLayer;
begin
  if not Assigned(d_player) or not Assigned(d_obstacleManager) then
    Exit;

  d_isRunning := True;
  d_gameOver := False;
  d_survivalTime := 0;
  d_distanceMeters := 0;
  d_worldScrollX := 0;

  d_player.SetPosition(TPointF.Create(d_player_x, d_player_y));
  d_player.SetGroundY(d_player_y);
  d_player.ChangeState(psIdle);

//  ChangeDemonState(dsHidden);
//  d_demon.d_demonFrameIndex := 0;
//  d_demon.d_demonAnimTimer := 0;
//  d_demon.d_nextDemonMeter := TGameConfig.DEMON_FIRST_METER;
  d_demon.ChangeDemonState(dsHidden);

  d_cameraX := 0;
  d_worldPlayerX := d_player_x;
  d_lastFrontPlayerWorldX := d_worldPlayerX;

  if AResetObstacles then
    d_obstacleSpawnWorldX := d_worldPlayerX;

//  if Assigned(d_imgDemon) then
//    d_imgDemon.Visible := False;

  for bg in d_backgrounds do
    bg.ResetPosition;

  if AResetObstacles then
    d_obstacleManager.Reset;

end;

constructor TGameEngine.Create;
begin
  inherited;
  // score and distance values
  d_distanceMeters := 0;
  d_pixelsPerMeter := TGameConfig.PIXELS_PER_METER;

  // create main game objects
  d_player := TPlayer.Create;
  d_obstacleManager := TObstacleManager.Create;
  d_assets := TAssetManager.Create;
  d_backgrounds := TObjectList<TBackgroundLayer>.Create(True);
  d_demon := TDemonManager.Create;

  d_isRunning := False;
  d_gameOver := False;
  d_survivalTime := 0;
  d_worldScrollX := 0;

  // player draw sizes
  d_playerNormalW := TGameConfig.PLAYER_NORMAL_WIDTH;
  d_playerNormalH := TGameConfig.PLAYER_NORMAL_HEIGHT;
  d_playerJetpackW := TGameConfig.PLAYER_JETPACK_WIDTH;
  d_playerJetpackH := TGameConfig.PLAYER_JETPACK_HEIGHT;

  d_remotePlayerRenderer := TRemotePlayerRenderer.Create;
  d_collisionEnabled := True;
  d_isHostMode := True;
  d_restartProtectionTimer := 0;
  d_cameraX := 0;
  d_worldPlayerX := 0;

  d_lastFrontPlayerWorldX := 0;
  d_obstacleSpawnWorldX := 0;

  // for reuse
  d_lastPlayerFrame := -1;
  d_lastPlayerState := psIdle;
  d_lastDemonFrame := -1;
  d_lastPatatoFrame:= -1;
  d_lastJetpackUpFrame:= -1;
  d_lastJetpackFlyFrame:= -1;
  d_lastDragonFrame:= -1;
  d_lastObstacleFrame:= -1;
  d_obstacleImages := TObjectList<TImage>.Create(True);
end;

destructor TGameEngine.Destroy;
begin
  FreeAndNil(d_player);
  FreeAndNil(d_obstacleManager);
  FreeAndNil(d_obstacleImages);
  FreeAndNil(d_backgrounds);
  FreeAndNil(d_assets);
  FreeAndNil(d_remotePlayerRenderer);
  FreeAndNil(d_demon);
  inherited;
end;

procedure TGameEngine.RebuildBackgrounds;
begin
  if not Assigned(d_imgPlayer) or not Assigned(d_imgPlayer.Parent) then
    Exit;

  // remove old background layers
  d_backgrounds.Clear;

  // parallax values
  // 0.2 moves slow and looks far away
  // 0.5 moves faster and looks closer
  // 1.0 moves with full speed and looks near
   d_backgrounds.Add(TBackgroundLayer.Create(d_imgPlayer.Parent, d_assets.BgFarBitmap, TGameConfig.BACKGROUND_FAR_SPEED));
   d_backgrounds.Add(TBackgroundLayer.Create(d_imgPlayer.Parent, d_assets.BgMidBitmap, TGameConfig.BACKGROUND_MID_SPEED));
   d_backgrounds.Add(TBackgroundLayer.Create(d_imgPlayer.Parent, d_assets.BgFrontBitmap, TGameConfig.BACKGROUND_FRONT_SPEED));;

  ApplyLayerOrder;
end;

procedure TGameEngine.ApplyLayerOrder;
var
  img: TImage;
begin
  if d_backgrounds.Count < 3 then
    Exit;

  // far background goes behind everything
  d_backgrounds[0].SendToBack;

  // middle background is above far background
  d_backgrounds[1].BringToFront;

  // demon is placed between middle and front background
  if Assigned(d_demon.d_imgDemon) then
    d_demon.d_imgDemon.BringToFront;

  // front background is above demon
  d_backgrounds[2].BringToFront;

  for img in d_obstacleImages do
    img.BringToFront;

  if Assigned(d_remotePlayerRenderer) then
    d_remotePlayerRenderer.BringToFront;

  if Assigned(d_imgPlayer) then
    d_imgPlayer.BringToFront;

  if Assigned(d_imgObstacleTemplate) then
    d_imgObstacleTemplate.BringToFront;
end;

procedure TGameEngine.SetCanvasSize(const aWidth: Single; const aHeight: Single);
var
  playerH, obstacleH: Single;
  bg: TBackgroundLayer;
begin
  if (aWidth <= 0) or (aHeight <= 0) then
    Exit;

  if Assigned(d_imgPlayer) then
    playerH := d_imgPlayer.Height
  else
    playerH := 64;

  if Assigned(d_imgObstacleTemplate) then
    obstacleH := d_imgObstacleTemplate.Height
  else
    obstacleH := 64;

  // player starts on the left side of the screen
  d_player_x := TGameConfig.PLAYER_START_X;

  // y position is screen height minus player height
  // this places the bottom of the player on the ground
  d_player_y := aHeight - playerH;

  // obstacles spawn a bit outside the right side
  // this makes them move into view instead of suddenly appearing
  d_obstacle_x := aWidth + 40;
  d_obstacle_y := aHeight - obstacleH;

  if Assigned(d_obstacleManager) then
    d_obstacleManager.SetDragonSpawnYRange(TGameConfig.DRAGON_SPAWN_MIN_Y, aHeight * 0.55);

  if Assigned(d_player) then
  begin
    d_player.SetPosition(TPointF.Create(d_player_x, d_player_y));
    d_player.SetGroundY(d_player_y);
  end;

  for bg in d_backgrounds do
    bg.Resize(aWidth, aHeight);
end;

procedure TGameEngine.Initialize(AForm: TForm);
var
  GameContainer: TComponent;
begin
  if not Assigned(AForm) then
    raise Exception.Create('game form is not assigned');

  d_form := AForm;

  GameContainer := d_form.FindComponent('layGameContainer');

  if not Assigned(GameContainer) then
    raise Exception.Create('laygamecontainer was not found');

  d_imgPlayer := GameContainer.FindComponent('imgPlayer') as TImage;

  if not Assigned(d_imgPlayer) then
    raise Exception.Create('imgplayer was not found');

  d_imgObstacleTemplate := GameContainer.FindComponent('imgObstacle1') as TImage;

  if not Assigned(d_imgObstacleTemplate) then
    raise Exception.Create('imgobstacle1 was not found');

  d_assets.LoadThemeAssets;

  d_obstacleManager.SetPotatoTotalFrames(d_assets.GetPotatoFrameCount);
  d_obstacleManager.SetDragonTotalFrames(d_assets.GetDragonFrameCount);
  d_obstacleManager.SetTotalFrames(d_assets.GetObstacleFrameCount);



  d_imgPlayer.Width := TGameConfig.PLAYER_NORMAL_WIDTH;
  d_imgPlayer.Height := TGameConfig.PLAYER_NORMAL_HEIGHT;
  d_imgPlayer.HitTest := False;
  d_imgPlayer.WrapMode := TImageWrapMode.Fit;
  d_imgPlayer.RotationCenter.X := 0.5;
  d_imgPlayer.RotationCenter.Y := 0.5;

  if Assigned(d_remotePlayerRenderer) then
  d_remotePlayerRenderer.Initialize(
    d_form,
    d_imgPlayer.Parent as TControl,
    d_imgPlayer,
    d_assets
  );

  d_imgObstacleTemplate.Width := TGameConfig.OBSTACLE_NORMAL_WIDTH;
  d_imgObstacleTemplate.Height := TGameConfig.OBSTACLE_NORMAL_HEIGHT;
  d_imgObstacleTemplate.HitTest := False;

  Randomize;

  d_obstacleManager.SetSpeed(TGameConfig.OBSTACLE_SPEED);
  d_obstacleManager.Initialize;

  RebuildBackgrounds;

  d_imgDemon := TImage.Create(d_imgPlayer.Parent);
  d_imgDemon.Parent := d_imgPlayer.Parent;
  d_imgDemon.Width := d_demon.d_demonW;
  d_imgDemon.Height := d_demon.d_demonH;
  d_imgDemon.WrapMode := TImageWrapMode.Fit;
  d_imgDemon.HitTest := False;
  d_imgDemon.Stored := False;
  d_imgDemon.Visible := False;

  ApplyLayerOrder;
end;

procedure TGameEngine.StartGame;
begin
  StartGameWithOptions(True);
  ApplyLayerOrder;
end;

procedure TGameEngine.StopGame;
begin
  d_isRunning := False;
end;

procedure TGameEngine.GameOver;
begin
  if d_gameOver then
    Exit;

  // keep the game loop alive for multiplayer sync
  d_gameOver := True;
  d_player.ChangeState(psDead);

  if Assigned(d_player) then
    d_player.StopSpeedBoost;

  if Assigned(d_onGameOver) then
    d_onGameOver;
end;

procedure TGameEngine.RestartGame(const AResetObstacles: Boolean);
begin
  StartGameWithOptions(AResetObstacles);

  if not AResetObstacles then
    d_restartProtectionTimer := TGameConfig.RESTART_PROTECTION_TIME;

  ApplyLayerOrder;
end;

procedure TGameEngine.HandleJump;
begin
  if d_isRunning and not d_gameOver and Assigned(d_player) then
    d_player.Jump;
end;

procedure TGameEngine.Update(const ADeltaTime: Single; const MoveLeft, MoveRight, MoveUp, MoveDown: Boolean);
var
  bg: TBackgroundLayer;
  playerPos: TPointF;
  mid: Single;
  scrollVelocity: Single;
  hitObstacle: TObstacle;
  targetY: Single;
  parentControl: TControl;
  spawnBaseX: Single;
begin
  try
    // bad delta time can break movement math, so ignore it
    if ADeltaTime <= 0 then
      Exit;

    if not d_isRunning then
      Exit;

    if not Assigned(d_player) or not Assigned(d_obstacleManager) then
      Exit;

    if not Assigned(d_imgPlayer) or not Assigned(d_imgPlayer.Parent) then
      Exit;

    parentControl := d_imgPlayer.Parent as TControl;
    scrollVelocity := 0;

    // if game over, keep obstacle sync alive for multiplayer
    if d_gameOver then
    begin
      d_worldPlayerX := d_cameraX + d_player.GetPosition.X;

      if d_isHostMode then
      begin
        spawnBaseX := GetSafeSpawnBaseX(parentControl.Width);

        d_obstacleManager.SetSpawnPosition(
          TPointF.Create(spawnBaseX, d_obstacle_y)
        );

        d_obstacleManager.Update(
          ADeltaTime,
          d_player,
          True,
          GetFrontPlayerSpeed(ADeltaTime)
        );

        d_obstacleManager.RemoveObstaclesLeftOf(GetLastPlayerWorldX - TGameConfig.REMOVE_OBSTACLE_MARGIN);
      end
      else
        d_obstacleManager.UpdateRemoteOnly(ADeltaTime);

      Exit;
    end;

    d_player.Update(ADeltaTime, MoveLeft, MoveRight, MoveUp, MoveDown);

    playerPos := d_player.GetPosition;

    // middle of the screen
    // width divided by 2 gives the center x position
    mid := parentControl.Width / 2;

    // distance score
    // velocity is pixels per second
    // velocity times delta time gives pixels moved this frame
    // divide by pixels per meter to change pixels into meters
    d_distanceMeters := d_distanceMeters + (Abs(d_player.GetVelocityX) * ADeltaTime / d_pixelsPerMeter);

    // start demon event at 50 meters and then every 100 meters
    if (d_demon.d_demonState = dsHidden) and (d_distanceMeters >= d_demon.d_nextDemonMeter) then
      d_demon.StartDemonEvent(parentControl);

    d_demon.UpdateDemon(ADeltaTime, parentControl);

    // camera scroll logic
    // player stays near the middle while the camera moves through the world
    if (playerPos.X > mid) and (d_player.GetVelocityX > 0) then
    begin
      playerPos.X := mid;
      d_player.SetPosition(playerPos);

      // world moves with player speed
      scrollVelocity := d_player.GetVelocityX;
    end
    else if (playerPos.X < d_player_x) and (d_player.GetVelocityX < 0) and (d_cameraX > 0) then
    begin
      playerPos.X := d_player_x;
      d_player.SetPosition(playerPos);

      // negative speed moves camera back left
      scrollVelocity := d_player.GetVelocityX;
    end
    else if playerPos.X < d_player_x then
    begin
      playerPos.X := d_player_x;
      d_player.SetPosition(playerPos);

      // camera can not move more left
      scrollVelocity := 0;
    end;

    // move camera
    // speed times delta time gives how many pixels camera moves this frame
    d_cameraX := d_cameraX + (scrollVelocity * ADeltaTime);

    // do not allow camera to go before start of world
    if d_cameraX < 0 then
    begin
      d_cameraX := 0;
      scrollVelocity := 0;
    end;

    // world player x is real position in the world
    // camera x is how far the world has scrolled
    // player screen x is where player is drawn
    d_worldPlayerX := d_cameraX + d_player.GetPosition.X;

    for bg in d_backgrounds do
      bg.Update(ADeltaTime, scrollVelocity);

    // obstacle spawn x is in world space
    // camera x plus screen spawn x means obstacle spawns ahead in the world

    if d_isHostMode then
    begin
      spawnBaseX := GetSafeSpawnBaseX(parentControl.Width);

      d_obstacleManager.SetSpawnPosition(
        TPointF.Create(spawnBaseX, d_obstacle_y)
      );

      d_obstacleManager.SetDifficultyByMeters(d_distanceMeters);
      d_obstacleManager.Update(
        ADeltaTime,
        d_player,
        d_player.CurrentState = psJetpackFlying,
        GetFrontPlayerSpeed(ADeltaTime)
      );

      if Assigned(d_remotePlayerRenderer) and d_remotePlayerRenderer.HasRemotePlayers then
      begin
        d_obstacleManager.EnsureObstacleNearPlayer(
          GetLastPlayerWorldX,
          parentControl.Width,
          d_obstacle_y
        );
      end;


      d_obstacleManager.RemoveObstaclesLeftOf(GetLastPlayerWorldX - TGameConfig.REMOVE_OBSTACLE_MARGIN);
    end
    else
      d_obstacleManager.UpdateRemoteOnly(ADeltaTime);

    // update timer for restart
    if d_restartProtectionTimer > 0 then
    begin
      d_restartProtectionTimer := d_restartProtectionTimer - ADeltaTime;

      if d_restartProtectionTimer < 0 then
        d_restartProtectionTimer := 0;
    end;

    d_survivalTime := d_survivalTime + ADeltaTime;

    d_scoreUpdateTimer := d_scoreUpdateTimer + ADeltaTime;

    if d_scoreUpdateTimer >= TGameConfig.SCORE_UPDATE_INTERVAL then
    begin
      d_scoreUpdateTimer := 0;

      if Assigned(d_onScoreUpdate) then
        d_onScoreUpdate(d_distanceMeters);
    end;

        // block collision
    if (not d_collisionEnabled) or (d_restartProtectionTimer > 0) then
      Exit;

    // collision uses world position
    // player is normally stored as screen position
    // so we temporarily put player x into world position
    playerPos := d_player.GetPosition;
    d_player.SetPosition(TPointF.Create(d_worldPlayerX, playerPos.Y));

    hitObstacle := d_obstacleManager.GetCollidingObstacle(d_player);

    // put player back to screen position
    d_player.SetPosition(playerPos);

    if Assigned(hitObstacle) then
    begin
     if hitObstacle.GetKind = okPotato then
      begin
        targetY := (parentControl.Height / 2) - (d_imgPlayer.Height / 2);

        d_player.StartJetpack(targetY);
        d_obstacleManager.RemoveObstacle(hitObstacle);
      end
      else if hitObstacle.GetKind = okRedbull then
      begin
        d_player.StartSpeedBoost(TGameConfig.REDBULL_PLAYER_SPEED_MULTIPLIER);
        d_obstacleManager.RemoveObstacle(hitObstacle);
      end
      else
      begin
        GameOver;
        Exit;
      end;
    end;



  except
    on E: Exception do
      TErrorHandler.ReportError('game update error: ' + E.Message);
  end;
end;

procedure TGameEngine.Render;
var
  frameIndex: Integer;
  playerPos: TPointF;
  obstacle: TObstacle;
  img: TImage;
  i: Integer;
  angle: Single;
  obstacleBitmap: TBitmap;
begin
  if not Assigned(d_imgPlayer) or not Assigned(d_player) or not Assigned(d_obstacleManager) then
    Exit;

  playerPos := d_player.GetPosition;

  // reset of state
  if d_lastPlayerState <> d_player.CurrentState then
  begin
    d_lastPlayerState := d_player.CurrentState;
    d_lastPlayerFrame := -1;
    d_lastDemonFrame := -1;
    d_lastPatatoFrame:= -1;
    d_lastJetpackUpFrame:= -1;
    d_lastJetpackFlyFrame:= -1;
    d_lastDragonFrame:= -1;
    d_lastObstacleFrame:= -1;
  end;

  // jetpack sprites are bigger than normal sprites
  if d_player.CurrentState in [psJetpackUp, psJetpackFlying] then
  begin
    d_imgPlayer.Width := d_playerJetpackW;
    d_imgPlayer.Height := d_playerJetpackH;
  end
  else
  begin
    d_imgPlayer.Width := d_playerNormalW;
    d_imgPlayer.Height := d_playerNormalH;
  end;

  // center bigger sprite around the normal player body
  // width difference divided by 2 gives the extra space on each side
  if d_player.CurrentState in [psJetpackUp, psJetpackFlying] then
  begin
    d_imgPlayer.Scale.X := 1;
    d_imgPlayer.Position.X := playerPos.X - ((d_imgPlayer.Width - d_playerNormalW) / 2);
  end
  else if d_player.GetFacingRight then
  begin
    d_imgPlayer.Scale.X := 1;
    d_imgPlayer.Position.X := playerPos.X - ((d_imgPlayer.Width - d_playerNormalW) / 2);
  end
  else
  begin
    // when flipped left, the image anchor changes
    // this math keeps the player visually in the same place
    d_imgPlayer.Scale.X := -1;
    d_imgPlayer.Position.X := playerPos.X + d_playerNormalW + ((d_imgPlayer.Width - d_playerNormalW) / 2);
  end;

  // keep feet on the same ground line when sprite height changes
  d_imgPlayer.Position.Y := playerPos.Y - (d_imgPlayer.Height - d_playerNormalH);

  if d_player.CurrentState = psJetpackUp then
  begin
    d_imgPlayer.RotationAngle := 0;

    if d_assets.d_jetpackUpFrames.Count > 0 then
    begin
      // timer times 10 means about 10 frames per second
      // mod loops back to first frame after the last frame
      frameIndex := Trunc(d_player.GetJetpackTimer * 10) mod d_assets.d_jetpackUpFrames.Count;
      SetImageBitmapIfChanged(d_imgPlayer, d_assets.d_jetpackUpFrames[frameIndex], d_lastJetpackUpFrame, frameIndex);
    end;
  end
  else if d_player.CurrentState = psJetpackFlying then
  begin
    d_imgPlayer.RotationAngle := 0;

    if d_assets.d_jetpackFlyFrames.Count > 0 then
    begin
      frameIndex := Trunc(d_player.GetJetpackTimer * 10) mod d_assets.d_jetpackFlyFrames.Count;
      SetImageBitmapIfChanged(d_imgPlayer, d_assets.d_jetpackFlyFrames[frameIndex], d_lastJetpackFlyFrame, frameIndex);
    end;
  end
  else if d_player.GetIsInAir then
  begin
    d_imgPlayer.Bitmap.Assign(d_assets.d_jumpSprite);  // miss ook voor reuse, haal deze comment weg als ik dit heb gedaan

    // spin while jumping
    // 360 means one full turn
    // air time divided by 0.6 means one full turn takes 0.6 seconds
    angle := 360 * (d_player.GetAirTime / 0.6);
    d_imgPlayer.RotationAngle := angle;
  end
  else
  begin
    d_imgPlayer.RotationAngle := 0;

    if d_player.CurrentState = psRunning then
    begin
      frameIndex := d_player.GetCurrentSpriteIndex;

      if (frameIndex >= 0) and (frameIndex < d_assets.d_playerFrames.Count) then
        SetImageBitmapIfChanged(d_imgPlayer, d_assets.d_playerFrames[frameIndex], d_lastPlayerFrame, frameIndex);
    end
    else if d_assets.d_playerFrames.Count > 0 then
      d_imgPlayer.Bitmap.Assign(d_assets.d_playerFrames[0]);
  end;

  if Assigned(d_imgDemon) and (d_demon.d_demonState <> dsHidden) and (d_assets.DemonFrames.Count > 0) then
  begin
    d_demon.d_demonFrameIndex := EnsureRange(d_demon.d_demonFrameIndex, 0, d_assets.DemonFrames.Count - 1);

    SetImageBitmapIfChanged(
      d_imgDemon,
      d_assets.DemonFrames[d_demon.d_demonFrameIndex],
      d_lastDemonFrame,
      d_demon.d_demonFrameIndex
    );

    d_imgDemon.Width := d_demon.d_demonW;
    d_imgDemon.Height := d_demon.d_demonH;
  end;

  // make enough image components for all obstacles
  //while (d_obstacleImages.Count < d_obstacleManager.GetObstacles.Count) and (d_obstacleImages.Count < MAX_OBSTACLE_IMAGES) do
  while d_obstacleImages.Count < d_obstacleManager.GetObstacles.Count do
  begin
    img := TImage.Create(d_form);
    img.Parent := d_imgPlayer.Parent;
    img.Width := TGameConfig.OBSTACLE_NORMAL_WIDTH;
    img.Height := TGameConfig.OBSTACLE_NORMAL_HEIGHT;
    img.WrapMode := TImageWrapMode.Fit;
    img.HitTest := False;
    img.BringToFront;
    d_obstacleImages.Add(img);
  end;

  //for i := 0 to Min(d_obstacleManager.GetObstacles.Count, d_obstacleImages.Count) - 1 do
  for i := 0 to d_obstacleManager.GetObstacles.Count - 1 do
  begin
    obstacle := d_obstacleManager.GetObstacles[i];
    img := d_obstacleImages[i];
    img.Visible := True;

    img.Width := obstacle.GetSize.Width;
    img.Height := obstacle.GetSize.Height;

    obstacleBitmap := d_assets.GetObstacleBitmap(obstacle.GetKind, obstacle.GetFrameIndex);

    if Assigned(obstacleBitmap) then
      img.Bitmap.Assign(obstacleBitmap);

    // convert world x to screen x
    // obstacle x is stored in the world
    // camera x is how far the world is scrolled
    // world x minus camera x gives draw position on screen
    img.Position.X := obstacle.GetPosition.X - d_cameraX;
    img.Position.Y := obstacle.GetPosition.Y;
  end;

  // hide image components that are not used this frame
  for i := d_obstacleManager.GetObstacles.Count to d_obstacleImages.Count - 1 do
    d_obstacleImages[i].Visible := False;

end;




procedure TGameEngine.UpdateRemotePlayer(const AName: string; const AX, AY: Single; const AState, AFrame: Integer; const AFacingRight: Boolean; const AAirTime: Single);
begin
  if not Assigned(d_remotePlayerRenderer) then
    Exit;

  d_remotePlayerRenderer.UpdateRemotePlayer(
    AName,
    AX,
    AY,
    AState,
    AFrame,
    AFacingRight,
    AAirTime,
    d_cameraX
  );
end;




