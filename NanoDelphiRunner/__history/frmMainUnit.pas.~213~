begin
  FreeAndNil(d_client);
  FreeAndNil(d_server);
  FreeAndNil(d_sessions);
  FreeAndNil(d_lobbyPlayers);
  FreeAndNil(d_input);
  FreeAndNil(d_gameEngine);
  FreeAndNil(d_playerScores);
  FreeAndNil(d_homeScreen);
  FreeAndNil(d_lobbyScreen);
  inherited;
end;

