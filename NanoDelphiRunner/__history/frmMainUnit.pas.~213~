// this loads the player name from an ini file
// the ini file is saved next to the exe
procedure TfrmMain.LoadPlayerName;
var
  Ini: TIniFile;
  FileName: string;
begin
  try
  // ParamStr(0) is the full path to the running exe
  // ExtractFilePath gets only the folder part
  FileName := ExtractFilePath(ParamStr(0)) + 'AdventureRunner.ini';

  Ini := TIniFile.Create(FileName);
  try
    // read the saved player name
    // if there is no saved name yet, use Player
    d_playerName := Ini.ReadString('player', 'name', 'Player');
  finally
    Ini.Free;
  end;

//  if Assigned(edtPlayerName) then
//    edtPlayerName.Text := d_playerName;

    if Assigned(d_homeScreen) and Assigned(d_homeScreen.PlayerNameEdit) then
      d_homeScreen.PlayerNameEdit.Text := d_playerName;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit LoadPlayerName error: ' + E.Message);
    end;
  end;
end;

// this saves the player name to an ini file
// this is called while the user types
procedure TfrmMain.SavePlayerName;
var
  Ini: TIniFile;
  FileName: string;
begin
  try
  // this creates the file path next to the exe
  FileName := ExtractFilePath(ParamStr(0)) + 'AdventureRunner.ini';

  Ini := TIniFile.Create(FileName);
  try
    Ini.WriteString('player', 'name', d_playerName);
  finally
    Ini.Free;
  end;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit SavePlayerName error: ' + E.Message);
    end;
  end;
end;

// this runs every time the user types in the name field
// the name is saved right away, without a save button
procedure TfrmMain.edtPlayerNameTyping(Sender: TObject);
begin
  try
  //d_playerName := Trim(edtPlayerName.Text);
  d_playerName := Trim(d_homeScreen.PlayerNameEdit.Text);

  if d_playerName = '' then
    d_playerName := 'Player';

  SavePlayerName;

  // update the lobby list so the local name is shown correctly
  RefreshLobbyPlayersList;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit edtPlayerNameTyping error: ' + E.Message);
    end;
  end;
end;

// this updates the start button when multiplayer is checked or unchecked
procedure TfrmMain.chkMultiplayerChange(Sender: TObject);
begin
  UpdateStartButtonText;
end;

// this redraws the lobby player list
// the names come from the server through the lobby message
procedure TfrmMain.RefreshLobbyPlayersList;
var
  Item: TListBoxItem;
  I: Integer;
begin
  try
  if not Assigned(d_lobbyScreen) or not Assigned(d_lobbyScreen.LobbyPlayerList) then
    Exit;

  d_lobbyScreen.LobbyPlayerList.Clear;

  if Assigned(d_lobbyPlayers) and (d_lobbyPlayers.Count > 0) then
  begin
    for I := 0 to d_lobbyPlayers.Count - 1 do
    begin
      Item := TListBoxItem.Create(d_lobbyScreen.LobbyPlayerList);
      Item.Parent := d_lobbyScreen.LobbyPlayerList;
      Item.Text := d_lobbyPlayers[I];
      Item.Height := 42;
    end;
  end
  else
  begin
    Item := TListBoxItem.Create(d_lobbyScreen.LobbyPlayerList);
    Item.Parent := d_lobbyScreen.LobbyPlayerList;
    Item.Text := d_playerName + '  jij';
    Item.Height := 42;
  end;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit RefreshLobbyPlayersList error: ' + E.Message);
    end;
  end;
end;

// this sends the player to the lobby
// it also tells the server that this player wants to join matchmaking
procedure TfrmMain.GoToLobby;
begin
  tcContent.ActiveTab := TabLobby;
  d_multiplayerActive := True;
  if Assigned(d_client) then
    // find means join or create a lobby
    // the player name is sent with it
    d_client.SendLine('find|' + d_playerName);

  UpdateStartButtonText;
end;

// this starts the actual game on this client
// in multiplayer this is called when the server sends startgame
procedure TfrmMain.StartSinglePlayerGame;
begin
try
  d_multiplayerActive := Assigned(d_homeScreen) and d_homeScreen.MultiplayerCheckBox.IsChecked;
  tcContent.ActiveTab := tabGame;
  btnStartAndLeave.Text := 'Leave Game';

  HideGameOver;
  layGameContainer.SetFocus;

  if Assigned(d_gameEngine) then
    d_gameEngine.StartGame;

  // this timer drives the game update and render loop
  tmrGameLoop.Enabled := True;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit StartSinglePlayerGame error: ' + E.Message);
    end;
  end;
end;

// this stops the game and goes back to the home screen
procedure TfrmMain.LeaveToHome;
begin
  tcContent.ActiveTab := tabHome;

  if Assigned(d_gameEngine) then
    d_gameEngine.StopGame;

  tmrGameLoop.Enabled := False;
  UpdateStartButtonText;
end;

// this is used by the join button in the session list
procedure TfrmMain.btnJoinSessionClick(Sender: TObject);
begin
  d_homeScreen.MultiplayerCheckBox.IsChecked := True;
  GoToLobby;
end;

// this moves from lobby back to home
procedure TfrmMain.btnBackToHomeClick(Sender: TObject);
begin
  tcContent.ActiveTab := tabHome;
  UpdateStartButtonText;
end;

// this is the main button logic
// on home it starts single player or matchmaking
// in lobby it asks the server to start the game for all players
// in game it leaves the game
procedure TfrmMain.btnStartAndLeaveClick(Sender: TObject);
begin
  if tcContent.ActiveTab = tabHome then
  begin
    if Assigned(d_homeScreen) and Assigned(d_homeScreen.MultiplayerCheckBox) and d_homeScreen.MultiplayerCheckBox.IsChecked then
      GoToLobby
    else
      StartSinglePlayerGame;

    Exit;
  end;

  if tcContent.ActiveTab = TabLobby then
  begin
    if Assigned(d_client) then
      // start tells the server to send startgame to all lobby players
      d_client.SendLine('start');

    Exit;
  end;

  LeaveToHome;
end;

// this keeps the main button text correct for the current page
procedure TfrmMain.UpdateStartButtonText;
begin
  if tcContent.ActiveTab = tabHome then
  begin
    if Assigned(d_homeScreen) and Assigned(d_homeScreen.MultiplayerCheckBox) and d_homeScreen.MultiplayerCheckBox.IsChecked then
      btnStartAndLeave.Text := 'Start Matchmaking'
    else
      btnStartAndLeave.Text := 'Start Game';

    Exit;
  end;

  if tcContent.ActiveTab = TabLobby then
  begin
    btnStartAndLeave.Text := 'Start Game';
    Exit;
  end;

  btnStartAndLeave.Text := 'Leave Game';
end;

