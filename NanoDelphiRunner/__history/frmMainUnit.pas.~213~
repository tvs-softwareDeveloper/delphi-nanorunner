// this updates the score label
procedure TfrmMain.SetScore(const Score: Single);
var
  I: Integer;
  NameText: string;
  ScoreText: string;
begin
  if not Assigned(lblScore) then
    Exit;

  // store local score
  d_localScore := Score;

  // make sure local player is also inside the score list
  if Assigned(d_playerScores) then
    d_playerScores.Values[d_playerName] := Format('%.0f', [d_localScore]);

  // single player only shows own score
  if not Assigned(d_homeScreen) or not d_homeScreen.MultiplayerCheckBox.IsChecked then
  begin
    lblScore.Text := Format('%s: %.0f m', [d_playerName, Score]);
    Exit;
  end;

  // multiplayer shows all player names and scores
  ScoreText := '';

  if Assigned(d_lobbyPlayers) and (d_lobbyPlayers.Count > 0) then
  begin
    for I := 0 to d_lobbyPlayers.Count - 1 do
    begin
      NameText := d_lobbyPlayers[I];

      if ScoreText <> '' then
        ScoreText := ScoreText + sLineBreak;

      ScoreText := ScoreText + Format(
        '%s: %s m',
        [
          NameText,
          d_playerScores.Values[NameText]
        ]
      );
    end;
  end
  else
    ScoreText := Format('%s: %.0f m', [d_playerName, d_localScore]);

  lblScore.Text := ScoreText;
end;

