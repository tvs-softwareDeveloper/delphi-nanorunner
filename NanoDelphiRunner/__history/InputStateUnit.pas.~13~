unit InputStateUnit;

interface

uses
  System.Classes, System.UITypes;

type
  TInputState = class
  private
    d_jumpPressed: Boolean;
    FJumpQueued: Boolean;
    FMoveLeft: Boolean;
    FMoveRight: Boolean;
    FMoveUp: Boolean;
    FMoveDown: Boolean;
  public
    procedure Reset;
    procedure KeyDown(const AKey: Word);
    procedure KeyUp(const AKey: Word);
    procedure MouseDown(const Button: TMouseButton);

    function ConsumeJump: Boolean;
    function IsMovingLeft: Boolean;
    function IsMovingRight: Boolean;
    function isMovingDown: Boolean;
    function isMovingUp: Boolean;

  end;

implementation

procedure TInputState.Reset;
begin
  d_jumpPressed := False;
  FJumpQueued := False;
  FMoveLeft := False;
  FMoveRight := False;
  FMoveUp := False;
  FMoveDown := False;
end;

procedure TInputState.KeyDown(const AKey: Word);
begin
  if AKey = vkSpace then
    FJumpQueued := True;

  if AKey = vkLeft then
    FMoveLeft := True;

  if AKey = vkRight then
    FMoveRight := True;

  if AKey = vkUp then
    FMoveUp := True;

  if AKey = vkDown then
    FMoveDown := True;
end;

procedure TInputState.KeyUp(const AKey: Word);
begin
  if AKey = vkLeft then
    FMoveLeft := False;

  if AKey = vkRight then
    FMoveRight := False;

  if AKey = vkUp then
    FMoveUp := False;

  if AKey = vkDown then
    FMoveDown := False;
end;

procedure TInputState.MouseDown(const Button: TMouseButton);
begin
  if Button = TMouseButton.mbLeft then
    FJumpQueued := True;
end;

function TInputState.ConsumeJump: Boolean;
begin
  if FJumpQueued then
  begin
    d_jumpPressed := True;
    FJumpQueued := False;
  end;

  Result := d_jumpPressed;
  d_jumpPressed := False;
end;

function TInputState.IsMovingLeft: Boolean;
begin
  Result := FMoveLeft;
end;

function TInputState.IsMovingRight: Boolean;
begin
  Result := FMoveRight;
end;

function TInputState.IsMovingUp: Boolean;
begin
  Result := FMoveUp;
end;

function TInputState.IsMovingDown: Boolean;
begin
  Result := FMoveDown;
end;

end.
