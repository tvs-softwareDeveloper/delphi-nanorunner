//update scorelabel
procedure TfrmMain.SetScore(const Score: Single);
var
  I: Integer;
  NameText: string;
  ScoreText: string;
  ScoreValue: Single;
  HasScore: Boolean;
begin
  if not Assigned(lblScore) then
    Exit;

  d_localScore := Score;

  if Assigned(d_playerScores) then
    d_playerScores.Values[d_playerName] := Format('%.0f', [d_localScore]);

  if not Assigned(d_homeScreen) or not d_homeScreen.MultiplayerCheckBox.IsChecked then
  begin
    lblScore.Text := Format('%s: %.0f m', [d_playerName, Score]);
    Exit;
  end;

  ScoreText := '';
  HasScore := False;

  d_highestScore := 0;
  d_lowestScore := 0;
  d_highestScoreName := '';
  d_lowestScoreName := '';

  if Assigned(d_lobbyPlayers) and (d_lobbyPlayers.Count > 0) then
  begin
    for I := 0 to d_lobbyPlayers.Count - 1 do
    begin
      NameText := d_lobbyPlayers[I];

      if d_playerScores.Values[NameText] = '' then
        Continue;

      ScoreValue := StrToFloatDef(d_playerScores.Values[NameText], 0);

      if not HasScore then
      begin
        d_highestScore := ScoreValue;
        d_lowestScore := ScoreValue;
        d_highestScoreName := NameText;
        d_lowestScoreName := NameText;
        HasScore := True;
      end
      else
      begin
        if ScoreValue > d_highestScore then
        begin
          d_highestScore := ScoreValue;
          d_highestScoreName := NameText;
        end;

        if ScoreValue < d_lowestScore then
        begin
          d_lowestScore := ScoreValue;
          d_lowestScoreName := NameText;
        end;
      end;

      if ScoreText <> '' then
        ScoreText := ScoreText + sLineBreak;

      ScoreText := ScoreText + Format('%s: %.0f m', [NameText, ScoreValue]);
    end;

    if HasScore then
    begin
      lblScore.Text :=
        Format('highest score: %s %.0f m', [d_highestScoreName, d_highestScore]) + sLineBreak +
        Format('lowest score: %s %.0f m', [d_lowestScoreName, d_lowestScore]) + sLineBreak +
        sLineBreak +
        ScoreText;
    end;
  end;

  BringGameUiToFront;
end;

