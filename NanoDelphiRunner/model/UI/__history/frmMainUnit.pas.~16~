procedure TfrmMain.ChangeAppState(const ANewState: TGameAppState);
begin
  d_appState := ANewState;

  case d_appState of
    gasHome:
      begin
        tcContent.ActiveTab := tabHome;
        d_multiplayerActive := False;
        tmrGameLoop.Enabled := False;
        btnStartAndLeave.Text := 'Start Game';
        if Assigned(d_homeScreen) and Assigned(d_homeScreen.MultiplayerCheckBox) and d_homeScreen.MultiplayerCheckBox.IsChecked then
          btnStartAndLeave.Text := 'Start Matchmaking'
        else
          btnStartAndLeave.Text := 'Start Game';
      end;

    gasLobby:
      begin
        tcContent.ActiveTab := TabLobby;
        d_multiplayerActive := True;
        tmrGameLoop.Enabled := False;
        btnStartAndLeave.Text := 'Start Game';
      end;

    gasPlayingSingle:
      begin
        tcContent.ActiveTab := tabGame;
        d_multiplayerActive := False;
        tmrGameLoop.Enabled := True;
        btnStartAndLeave.Text := 'Leave Game';

        if Assigned(d_gameEngine) then
        begin
          d_gameEngine.SetHostMode(True);
          d_gameEngine.SetCollisionEnabled(True);
        end;
      end;

    gasPlayingMulti:
      begin
        tcContent.ActiveTab := tabGame;
        d_multiplayerActive := True;
        tmrGameLoop.Enabled := True;
        btnStartAndLeave.Text := 'Leave Game';

        if Assigned(d_gameEngine) then
        begin
          d_gameEngine.SetHostMode(d_isHost);
       //   d_gameEngine.SetCollisionEnabled(d_isHost);
        end;
      end;

    gasGameOver:
      begin
        tmrGameLoop.Enabled := True;
        btnStartAndLeave.Text := 'Leave Game';
      end;
  end;
end;

// this catches keyboard input from windows
// this helps because buttons or edit fields can sometimes take focus away from the game
function NewWndProc(hWnd: HWND; Msg: UINT; wParam: WPARAM; lParam: LPARAM): LRESULT; stdcall;
begin
  try
  if Assigned(frmMain) and Assigned(frmMain.d_input) then
  begin
    case Msg of
      WM_KEYDOWN:
        frmMain.d_input.KeyDown(wParam);

      WM_KEYUP:
        frmMain.d_input.KeyUp(wParam);
    end;
  end;

  // this sends the message back to the normal windows system after we used it
  Result := CallWindowProc(OldWndProc, hWnd, Msg, wParam, lParam);
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit new wnd proc error: ' + E.Message);
    end;
  end;
end;

// this searches inside a parent control until it finds the component name
// this is used because some game controls are inside the game frame
function FindComponentRecursive(AParent: TComponent; const AName: string): TComponent;
var
  I: Integer;
  Child: TComponent;
begin
  try
  Result := nil;

  if not Assigned(AParent) then
    Exit;

  Result := AParent.FindComponent(AName);

  if Assigned(Result) then
    Exit;

  for I := 0 to AParent.ComponentCount - 1 do
  begin
    Child := AParent.Components[I];
    Result := FindComponentRecursive(Child, AName);

    if Assigned(Result) then
      Exit;
  end;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit FindComponentRecursive error: ' + E.Message);
    end;
  end;
end;

// this runs once when the form opens
// it builds the ui, loads the player name, starts local multiplayer and prepares the game engine
procedure TfrmMain.FormCreate(Sender: TObject);
var
  Wnd: HWND;
begin
  try
  // this list stores player scores by player name
  d_playerScores := TStringList.Create;

  d_highestScore := 0;
  d_lowestScore := 0;
  d_highestScoreName := '';
  d_lowestScoreName := '';
  d_hasMatchScoreRecord := False;

  // set the start size of the game window
  Self.Width := TGameConfig.WINDOW_WIDTH;
  Self.Height := TGameConfig.WINDOW_HEIGHT;

  Self.Constraints.MinWidth := TGameConfig.WINDOW_WIDTH;
  Self.Constraints.MaxWidth := TGameConfig.WINDOW_WIDTH;
  Self.Constraints.MinHeight := TGameConfig.WINDOW_HEIGHT;
  Self.Constraints.MaxHeight := TGameConfig.WINDOW_HEIGHT;

  // place the window in the center of the screen
  Self.Position := TFormPosition.ScreenCenter;

  // hide the tab buttons because the code controls which page is shown
  tcContent.TabPosition := TTabPosition.None;
  tcContent.ActiveTab := tabHome;

  // this object stores keyboard and mouse input for the game loop
  d_input := TInputState.Create;

  // get game ui controls from the game frame
  lblScore := FindComponentRecursive(layGameContainer, 'lblScore') as TLabel;
  lblGameOver := FindComponentRecursive(layGameContainer, 'lblGameOver') as TLabel;
  btnRestart := FindComponentRecursive(layGameContainer, 'btnRestart') as TButton;

  if Assigned(lblScore) then
  begin
    lblScore.HitTest := False;
    lblScore.Align := TAlignLayout.None;
    lblScore.Anchors := [TAnchorKind.akTop, TAnchorKind.akLeft];
    lblScore.Margins.Left := 10;
    lblScore.Margins.Top := 10;
    lblScore.Margins.Right := 0;
    lblScore.Margins.Bottom := 0;
    lblScore.Width := 300;
    lblScore.Height := 220;
    lblScore.WordWrap := True;
    lblScore.Position.X := 10;
    lblScore.Position.Y := 10;
    lblScore.Font.Size := 15;
  end;

  // the start button should not steal keyboard focus during gameplay
  btnStartAndLeave.CanFocus := False;
  btnStartAndLeave.TabStop := False;
  // connect input events to this form
  Self.OnKeyDown := FormKeyDown;
  Self.OnKeyUp := FormKeyUp;
  layGameContainer.OnMouseDown := layGameContainerMouseDown;
  layGameContainer.CanFocus := True;
  d_lastFrameTime := TThread.GetTickCount64;//stopwatch windows
  d_homeScreen := THomeScreen.Create(tabHome);
  d_homeScreen.Build;
  d_lobbyScreen := TLobbyScreen.Create(TabLobby);
  d_lobbyScreen.Build;
  d_homeScreen.PlayerNameEdit.OnTyping := edtPlayerNameTyping;
  d_homeScreen.MultiplayerCheckBox.OnChange := chkMultiplayerChange;
  d_homeScreen.ThemeJapaneseButton.OnClick := btnThemeJapaneseClick;
  d_homeScreen.ThemeMoonlandingButton.OnClick := btnThemeMoonlandingClick;
  d_lobbyScreen.BackToHomeButton.OnClick := btnBackToHomeClick;
  ApplyMainStyling;
  ChangeAppState(gasHome);

  // load the saved name before multiplayer starts
  LoadPlayerName;

  // create the lists that store multiplayer data from the server
  d_lobbyPlayers := TStringList.Create;
  d_sessions := TStringList.Create;
  RefreshLobbyPlayersList;

  // create and prepare the game engine
  d_gameEngine := TGameEngine.Create;
  d_gameEngine.Initialize(Self);

  d_gameEngine.SetCanvasSize(layGameContainer.Width, layGameContainer.Height);

  // this lets the engine update the score text in this form
  d_gameEngine.SetOnScoreUpdate(
    procedure(S: Single)
    begin
      SetScore(S);
    end
  );

  // this lets the engine tell the form when the player lost
  d_gameEngine.SetOnGameOver(ShowGameOver);

  // this code is used when the restart button is clicked
  SetOnRestart(
    procedure
    begin
      HideGameOver;

    if Assigned(d_gameEngine) then
      d_gameEngine.RestartGame(not d_multiplayerActive);
          tmrGameLoop.Enabled := True;
      BringGameUiToFront;
    end
  );

  if Assigned(btnRestart) then
    btnRestart.OnClick := btnRestartClick;

  HideGameOver;
  SetScore(0);
  BringGameUiToFront;

  // this installs the windows keyboard hook for better input
  Wnd := WindowHandleToPlatform(Self.Handle).Wnd;
  OldWndProc := Pointer(SetWindowLongPtr(Wnd, GWLP_WNDPROC, LONG_PTR(@NewWndProc)));
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit formcreate error: ' + E.Message);
    end;
  end;
end;

// this starts the simple local multiplayer setup
// the first game window starts the server on port 7777
// every game window then connects to that server as a client
procedure TfrmMain.StartLocalMultiplayer;
var
  HostAddress: string;
begin
  try
    d_isHost := False;

    if Assigned(d_client) then
      FreeAndNil(d_client);

    if TGameConfig.AUTO_START_LOCAL_SERVER then
    begin
      if not Assigned(d_server) then
      begin
        d_server := TSimpleGameServer.Create;

        if d_server.Start(TGameConfig.SERVER_PORT) then
          ShowMessage('local server gestart op poort ' + TGameConfig.SERVER_PORT.ToString)
        else
          ShowMessage('local server kon niet starten');
      end;

      HostAddress := TGameConfig.LOCALHOST;
    end
    else
    begin
      HostAddress := Trim(edtCustomServerIP.Text); /// trim to delete white space characters etc..

      if HostAddress = '' then
        HostAddress := TGameConfig.SERVER_HOST;
    end;

    ShowMessage('ik probeer te verbinden met server: ' + HostAddress + ':' + TGameConfig.SERVER_PORT.ToString);

    d_client := TSimpleGameClient.Create;
    d_client.OnMessage := HandleServerMessage;

    if d_client.Connect(HostAddress, TGameConfig.SERVER_PORT) then
    begin
      ShowMessage('verbonden met server: ' + HostAddress);
      d_client.SendLine('getsessions');
    end
    else
    begin
      ShowMessage('kan niet verbinden met server: ' + HostAddress);
      TErrorHandler.ReportError('kan niet verbinden met server: ' + HostAddress);
    end;

    BringGameUiToFront;
  except
    on E: Exception do
    begin
      ShowMessage('StartLocalMultiplayer error: ' + E.Message);
      TErrorHandler.ReportError('frmMainUnit StartLocalMultiplayer error: ' + E.Message);
    end;
  end;
end;

// this receives messages from the multiplayer server
// messages are simple text commands like sessions, lobby and startgame
procedure TfrmMain.HandleServerMessage(const AMessage: string);
var
  Parts: TArray<string>;
begin
  try
  // messages use | as separator
  // example: lobby|player1,player2
  Parts := AMessage.Split(['|']);

  if Length(Parts) = 0 then
    Exit;

  if ((Parts[0] = 'state') or (Parts[0] = 'obstacles')) and
     (not d_multiplayerActive) then
    Exit;

  if Parts[0] = 'sessions' then
  begin
    d_sessions.Clear;

    // the session text contains spaces
    // so we add it as one full line and do not use CommaText here
    if (Length(Parts) > 1) and (Trim(Parts[1]) <> '') then
      d_sessions.Add(Parts[1]);

    RefreshSessionsList;
  end
  else if Parts[0] = 'lobby' then
  begin
    d_lobbyPlayers.Clear;

    // lobby players are sent with commas between names
    // example: player1,player2
    if Length(Parts) > 1 then
      d_lobbyPlayers.CommaText := Parts[1];

    RefreshLobbyPlayersList;
  end
  else if Parts[0] = 'startgame' then
  begin
    // when the server says startgame, all clients start the game
    StartSinglePlayerGame;
  end
  else if Parts[0] = 'state' then
  begin
    if Length(Parts) >= 9 then
    begin
      d_gameEngine.UpdateRemotePlayer(
        Parts[1],
        StrToFloatDef(Parts[2], 0, TFormatSettings.Invariant),
        StrToFloatDef(Parts[3], 0, TFormatSettings.Invariant),
        StrToIntDef(Parts[4], 0),
        StrToIntDef(Parts[5], 0),
        Parts[6] = '1',
        StrToFloatDef(Parts[7], 0, TFormatSettings.Invariant)
      );

      if Assigned(d_playerScores) then
        d_playerScores.Values[Parts[1]] := Format('%.0f', [StrToFloatDef(Parts[8], 0, TFormatSettings.Invariant)]);

      SetScore(d_localScore);
    end;
  end
  else if Parts[0] = 'host' then
  begin
    if Length(Parts) > 1 then
    begin
      d_isHost := SameText(Parts[1], d_playerName);

      if Assigned(d_gameEngine) then
      begin
        d_gameEngine.SetHostMode(d_isHost);
        d_gameEngine.SetCollisionEnabled(d_isHost);
      end;
    end;
  end
  else if Parts[0] = 'gameover' then
  begin
    if Length(Parts) >= 3 then
    begin
      UpdateMatchScoreRecords(
        Parts[1],
        StrToFloatDef(Parts[2], 0, TFormatSettings.Invariant),
        True
      );

      SetScore(d_localScore);
    end;
  end
  else if Parts[0] = 'obstacles' then
  begin
    if Assigned(d_gameEngine) and (not d_isHost) then
      d_gameEngine.ApplyObstacleSyncText(AMessage);
  end;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit HandleServerMessage error: ' + E.Message);
    end;
  end;
end;

// this redraws the open game sessions on the home screen
// each session gets a join button
procedure TfrmMain.RefreshSessionsList;
var
  Item: TListBoxItem;
  JoinButton: TButton;
  LabelText: TLabel;
  I: Integer;
begin
  try
  if not Assigned(d_homeScreen) or not Assigned(d_homeScreen.SessionList) then
    Exit;

  d_homeScreen.SessionList.Clear;

  if not Assigned(d_sessions) or (d_sessions.Count = 0) then
  begin
    Item := TListBoxItem.Create(d_homeScreen.SessionList);
    Item.Parent := d_homeScreen.SessionList;
    Item.Text := 'geen open game sessies';
    Item.Height := 46;
    Exit;
  end;

  for I := 0 to d_sessions.Count - 1 do
  begin
    Item := TListBoxItem.Create(d_homeScreen.SessionList);
    Item.Parent := d_homeScreen.SessionList;
    Item.Height := 46;

    LabelText := TLabel.Create(Item);
    LabelText.Parent := Item;
    LabelText.Text := d_sessions[I];
    LabelText.Position.X := 12;
    LabelText.Position.Y := 12;
    LabelText.Width := 250;
    LabelText.Height := 24;
    LabelText.StyledSettings := [];
    LabelText.TextSettings.FontColor := $FF11351F;
    LabelText.TextSettings.Font.Style := [TFontStyle.fsBold];

    JoinButton := TButton.Create(Item);
    JoinButton.Parent := Item;
    JoinButton.Text := 'Join';
    JoinButton.Position.X := 300;
    JoinButton.Position.Y := 6;
    JoinButton.Width := 76;
    JoinButton.Height := 34;

    // clicking join sends this player to the lobby
    JoinButton.OnClick := btnJoinSessionClick;
  end;
  except
    on E: Exception do
    begin
      TErrorHandler.ReportError('frmMainUnit RefreshSessionsList error: ' + E.Message);
    end;
  end;
end;



