procedure TGameEngine.SetOnScoreUpdate(const ACallback: TProc<Single>);
begin
  d_onScoreUpdate := ACallback;
end;

procedure TGameEngine.SetOnGameOver(const ACallback: TProc);
begin
  d_onGameOver := ACallback;
end;

procedure TGameEngine.ApplyObstacleSyncText(const AText: string);
begin
  TGameNetworkSync.ApplyObstacleSyncText(
    AText,
    d_obstacleManager,
    d_assets
  );
end;

function TGameEngine.GetPlayerSyncText(const APlayerName: string): string;
begin
  Result := TGameNetworkSync.GetPlayerSyncText(
    APlayerName,
    d_player,
    d_worldPlayerX,
    d_distanceMeters
  );
end;

function TGameEngine.GetObstacleSyncText: string;
begin
  Result := TGameNetworkSync.GetObstacleSyncText(d_obstacleManager);
end;

procedure TGameEngine.SetCollisionEnabled(const AValue: Boolean);
begin
  d_collisionEnabled := AValue;
end;

procedure TGameEngine.SetHostMode(const AValue: Boolean);
begin
  try
    // do nothing if the value did not change
    if d_isHostMode = AValue then
      Exit;

    d_isHostMode := AValue;

    // when this client becomes host, old remote obstacles must become normal moving obstacles
    if d_isHostMode and Assigned(d_obstacleManager) then
      d_obstacleManager.TakeOwnershipOfObstacles;
  except
    on E: Exception do
      TErrorHandler.ReportError('set host mode error: ' + E.Message);
  end;
end;

function TGameEngine.GetLastPlayerWorldX: Single;
begin
  Result := d_worldPlayerX;

  if Assigned(d_remotePlayerRenderer) then
    Result := d_remotePlayerRenderer.GetLastPlayerWorldX(d_worldPlayerX);
end;

function TGameEngine.GetFrontPlayerWorldX: Single;
begin
  Result := d_worldPlayerX;

  if Assigned(d_remotePlayerRenderer) then
    Result := d_remotePlayerRenderer.GetFrontPlayerWorldX(d_worldPlayerX);
end;

function TGameEngine.GetFrontPlayerSpeed(const ADeltaTime: Single): Single;
var
  FrontX: Single;
begin
  Result := 0;

  try
    if ADeltaTime <= 0 then
      Exit;

    FrontX := GetFrontPlayerWorldX;

    // never use backwards movement for spawning
    if FrontX <= d_lastFrontPlayerWorldX then
      Exit;

    // calculate forward speed of the front player
    Result := (FrontX - d_lastFrontPlayerWorldX) / ADeltaTime;

    // stop one big jump from spawning many obstacles after restart
    Result := Min(Result, TGameConfig.MAX_FRONT_PLAYER_SPEED);

    // save the highest known front position
    d_lastFrontPlayerWorldX := FrontX;
  except
    on E: Exception do
      TErrorHandler.ReportError('get front player speed error: ' + E.Message);
  end;
end;

function TGameEngine.GetSafeSpawnBaseX(const AParentWidth: Single): Single;
var
  FrontX: Single;
  WantedSpawnX: Single;
begin
  Result := d_obstacleSpawnWorldX;

  try
    FrontX := GetFrontPlayerWorldX;

    // spawn must be in front of the front player
    WantedSpawnX := FrontX + AParentWidth + TGameConfig.SPAWN_RIGHT_MARGIN;

    // spawn line may only move to the right
    if WantedSpawnX > d_obstacleSpawnWorldX then
      d_obstacleSpawnWorldX := WantedSpawnX;

    Result := d_obstacleSpawnWorldX;
  except
    on E: Exception do
      TErrorHandler.ReportError('get safe spawn base x error: ' + E.Message);
  end;
end;

end.
